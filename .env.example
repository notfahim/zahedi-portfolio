# The public base URL the site reads images/video/PDF keys from.
# Set to the Cloudflare-proxied custom domain in front of the R2 bucket —
# see docs/setup/external-services.md.
PUBLIC_MEDIA_BASE_URL=https://media.zahedishams.com

# Cloudflare R2 credentials, used by the publish CLIs and check-media only.
# Never needed by the site build. Values go in .env, which is gitignored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
