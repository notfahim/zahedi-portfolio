---
import { getEntry, getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { derivativeSrcSet, derivativeUrl, pickWidth } from "../lib/r2-url";

const about = await getEntry("about", "site");
const { heroImageKey, heroImageWidths, role } = about!.data;

/**
 * A real frame from the photography, chosen by the day so the page is not the
 * same picture every time, and so a missing photograph is not fatal.
 */
const photos = await getCollection("photography");
const stray = photos.length > 0 ? photos[new Date().getDate() % photos.length] : undefined;
const backdropKey = stray?.data.imageKey ?? heroImageKey;
const backdropWidths = stray ? stray.data.widths : heroImageWidths;
---
<BaseLayout title="Page not found — Zahedi Shams">
  <main class="lost">
    {backdropKey && (
      <div class="backdrop" data-media>
        <picture>
          <source type="image/avif" srcset={derivativeSrcSet(backdropKey, "avif", backdropWidths)} sizes="100vw" />
          <source type="image/webp" srcset={derivativeSrcSet(backdropKey, "webp", backdropWidths)} sizes="100vw" />
          <img
            src={derivativeUrl(backdropKey, pickWidth(1920, backdropWidths), "webp")}
            alt=""
            fetchpriority="high"
          />
        </picture>
      </div>
    )}

    <div class="panel">
      <p class="code">404</p>
      <h1>This frame doesn&rsquo;t exist</h1>
      <p class="blurb">
        The page you were after has been moved, renamed, or was never here.
        The work itself is all one page &mdash; pick a section and carry on.
      </p>

      <nav class="ways" aria-label="Sections">
        <a href="/#work">Work</a>
        <a href="/#photography">Photography</a>
        <a href="/#news">News &amp; Press</a>
        <a href="/#about">About</a>
      </nav>

      <a class="home" href="/">← Back to the start</a>
    </div>

    <p class="sig">Zahedi Shams &mdash; {role ?? "Director of Photography"}</p>
  </main>
</BaseLayout>

<script>
  import { initImageLoading } from "../scripts/image-loading";
  import { initReveal } from "../scripts/reveal";
  initImageLoading();
  initReveal();
</script>

<style>
  .lost {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    overflow: hidden;
  }

  /* A real photograph rather than an empty page: this is the one screen a
     visitor reaches by accident, so it should still look like the site. */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-bg);
  }

  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Well back, so the type over it stays legible whatever the frame. */
    filter: grayscale(0.35) brightness(0.32);
    transform: scale(1.04);
  }

  .panel {
    position: relative;
    z-index: 1;
    max-width: 34rem;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 9rem);
    font-weight: 600;
    line-height: 0.9;
    margin: 0;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-fg) 45%, transparent);
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 500;
    margin: 0.75rem 0 0;
  }

  .blurb {
    color: var(--color-muted);
    margin: 1rem 0 2rem;
    line-height: 1.6;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-bottom: 2.5rem;
  }

  .ways a {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.2em;
    border-bottom: 0.08em solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .ways a:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
  }

  .home {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-fg) 12%, transparent);
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .home:hover {
    background: color-mix(in srgb, var(--color-fg) 22%, transparent);
    transform: translateY(-2px);
  }

  .ways a:focus-visible,
  .home:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .sig {
    position: absolute;
    bottom: 1.75rem;
    z-index: 1;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
