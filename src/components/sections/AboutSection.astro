---
import { getEntry } from "astro:content";
import { derivativeUrl, derivativeSrcSet, pickWidth } from "../../lib/r2-url";
import { whatsappUrl } from "../../lib/contact";

const about = await getEntry("about", "site");
const { bio, representation, directInquiryEmail, whatsappNumber, location, portraitKey, portraitWidths, portraitAlt } = about!.data;
---
<section id="about" class="about-section">
  <div class="portrait" data-media data-reveal>
    <picture>
      <source type="image/avif" srcset={derivativeSrcSet(portraitKey, "avif", portraitWidths)} sizes="(min-width: 48rem) 24rem, 90vw" />
      <source type="image/webp" srcset={derivativeSrcSet(portraitKey, "webp", portraitWidths)} sizes="(min-width: 48rem) 24rem, 90vw" />
      <img src={derivativeUrl(portraitKey, pickWidth(1280, portraitWidths), "webp")} alt={portraitAlt} loading="lazy" />
    </picture>
  </div>
  <div class="copy">
    <h2>Zahedi Shams</h2>
    <p class="role">Director of Photography / Cinematographer</p>
    <p class="bio">{bio}</p>

    <h3>Representation &amp; Contact</h3>
    <ul class="representation">
      {representation.map((r) => (
        <li>
          {r.label}:{" "}
          {/* The contact line is free text — an address, an agency, a phone
              number. Only make it a link when it is actually an email. */}
          {r.contact.includes("@") ? (
            <a href={`mailto:${r.contact}`}>{r.contact}</a>
          ) : (
            r.contact
          )}
        </li>
      ))}
      <li>
        Direct Inquiry:{" "}
        {whatsappNumber ? (
          <a href={whatsappUrl(whatsappNumber)} target="_blank" rel="noopener noreferrer">
            {whatsappNumber} (WhatsApp)
          </a>
        ) : (
          <a href={`mailto:${directInquiryEmail}`}>{directInquiryEmail}</a>
        )}
      </li>
      <li>Location: {location}</li>
    </ul>

<p class="inquiry-hint">
      For quotations and inquiries, email <a href={`mailto:${directInquiryEmail}`}>{directInquiryEmail}</a>.
    </p>
  </div>
</section>

<style>
  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 24rem) 1fr;
    gap: 3rem;
    padding: 4rem 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  /* Stretched to the row's height (the grid's default), matching .copy —
     the portrait is now exactly as tall as the text beside it. The picture
     is absolutely positioned inside so it can cover that height without
     distorting; .portrait contributes no intrinsic height of its own, so
     the row's height comes from .copy alone rather than the two fighting
     over it. */
  .portrait {
    position: relative;
  }
  .portrait picture {
    display: block;
    height: 100%;
  }
  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .role {
    color: var(--color-muted);
  }
  .representation {
    list-style: none;
    padding: 0;
  }
  .inquiry-hint {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  @media (max-width: 48rem) {
    .about-section {
      grid-template-columns: 1fr;
    }
    /* Stacked layout: .portrait no longer shares a row with .copy, so it
       can't borrow the text's height. Fall back to a fixed aspect ratio. */
    .portrait {
      aspect-ratio: 4 / 5;
    }
  }
</style>
