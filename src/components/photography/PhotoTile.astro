---
import { derivativeUrl, derivativeSrcSet, pickWidth } from "../../lib/r2-url";

interface Props {
  imageKey: string;
  width: number;
  height: number;
  caption: string;
  location: string;
  year: number;
  camera?: string;
  rowSpan: number;
  widths?: number[];
}
const { imageKey, width, height, caption, location, year, camera, rowSpan, widths } = Astro.props;
---
<a
  href={derivativeUrl(imageKey, pickWidth(2560, widths), "webp")}
  class="photo-tile"
  style={`--span: ${rowSpan}; --ar: ${width} / ${height};`}
  data-pswp-width={width}
  data-pswp-height={height}
  data-caption={caption}
  data-location={location}
  data-year={year}
  data-camera={camera ?? ""}
  data-media
>
  <picture>
    <source type="image/avif" srcset={derivativeSrcSet(imageKey, "avif", widths)} sizes="(max-width: 40rem) 60vw, 30vw" />
    <source type="image/webp" srcset={derivativeSrcSet(imageKey, "webp", widths)} sizes="(max-width: 40rem) 60vw, 30vw" />
    <img
      src={derivativeUrl(imageKey, pickWidth(1280, widths), "webp")}
      width={width}
      height={height}
      alt={caption}
      loading="lazy"
    />
  </picture>
</a>

<style>
  /* A tile's height comes from how many of the wall's rows it spans; its
     width then follows the photograph's own aspect ratio. That is what
     keeps a landscape frame landscape — the previous fixed-width column
     forced every photo into the same portrait box and object-fit: cover
     cropped away whatever did not fit. */
  /* Width and height are set inline by photo-wall-layout.ts, which sizes
     each column so its photos fill the wall exactly. The fallback aspect
     ratio only applies for the instant before that runs. */
  .photo-tile {
    display: block;
    overflow: hidden;
    flex: none;
    aspect-ratio: var(--ar);
    /* Lifting the hovered tile means it overlaps its neighbours rather than
       being overlapped by whichever happens to come later in the wall. */
    position: relative;
    z-index: 0;
    transform: scale(1);
    transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 300ms ease;
  }
  .photo-tile img {
    width: 100%;
    height: 100%;
    /* Still cover, but now covering a box that already matches the photo's
       ratio, so it trims sub-pixel rounding rather than half the frame. */
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 450ms cubic-bezier(0.22, 0.61, 0.36, 1),
      filter 300ms ease;
  }

  /* Two scales, not one: the tile grows a little and the photo inside it
     grows a little more, so the frame fills rather than the whole thing
     simply getting bigger. The wall is packed to fill its height exactly, so
     the tile's share is kept small — anything more and the columns visibly
     collide. */
  .photo-tile:hover,
  .photo-tile:focus-visible {
    transform: scale(1.025);
    z-index: 2;
    box-shadow: 0 0.75rem 2rem color-mix(in srgb, #000 45%, transparent);
  }
  .photo-tile:hover img,
  .photo-tile:focus-visible img {
    transform: scale(1.07);
    filter: brightness(1.06);
  }

  /* Coarse pointers have no hover to speak of: the effect would stick to
     whichever tile was tapped last. */
  @media (hover: none) {
    .photo-tile:hover {
      transform: scale(1);
      box-shadow: none;
    }
    .photo-tile:hover img {
      transform: scale(1);
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-tile,
    .photo-tile img {
      transition: none;
    }
  }
</style>
